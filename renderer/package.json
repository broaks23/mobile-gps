{
  "name": "ridgewalk-map-renderer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build --configLoader native",
    "bundle:app": "npm run build && node scripts/copy-to-flutter.mjs && node scripts/verify-bundle.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans": "5.2.8",
    "maplibre-gl": "6.17.0",
    "pmtiles": "4.5.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
